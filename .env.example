# ───────────────────────── Ahem Corporation website ─────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph tags, structured data and links inside emails.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# First-run administrator (used once, when the database is empty).
# If ADMIN_PASSWORD is omitted, the documented default password is used and the
# dashboard shows a warning until it is changed. Set both in production.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@ahemcorporation.com
ADMIN_PASSWORD=

# Random secret (32+ chars) used to salt the anonymous daily visitor hash.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Outgoing email (confirmation emails + admin notifications).
# Leave SMTP_HOST empty to disable sending: messages are then recorded in
# Admin → Email log with the outcome "Not configured" instead of being sent.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); otherwise STARTTLS is used
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ahem Corporation <no-reply@example.com>"

# Clickjacking protection: who may embed the site in a frame.
# Recommended in production: 'self'   (leave empty only for hosted previews that iframe the site)
FRAME_ANCESTORS=

# Google Analytics and Search Console are configured in Admin → Website settings → SEO & analytics
# (no environment variable needed).
